# ═══════════════════════════════════════
# 小机后端配置
# 复制此文件为 .env 并填写真实值
# ═══════════════════════════════════════

# 服务端口
PORT=3000

# AI API 代理地址（你的 Cloudflare Worker）
# 留空则直接用 https://api.anthropic.com
AI_PROXY_URL=https://cilllllll.2621956601.workers.dev

# ═══ Gmail OAuth 配置 ═══
# 1. 去 https://console.cloud.google.com/ 新建项目
# 2. 启用 Gmail API
# 3. 创建 OAuth 2.0 凭据（桌面应用类型）
# 4. 在「测试用户」里添加你自己的 Gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# OAuth 回调地址（本机地址+端口）
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# token 存储路径
GMAIL_TOKEN_PATH=./gmail-tokens.json
